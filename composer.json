{
    "name": "dpay/dpay-php",
    "description": "Official DPay PHP SDK — hosted checkout sessions, payment sessions (EDFali, Sadad, MobiCash, MITF banks, Moamalat, Mastercard), signed webhooks and the sandbox, for PHP 8.1+.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "dpay",
        "payments",
        "libya",
        "sdk",
        "checkout",
        "edfali",
        "sadad",
        "moamalat",
        "mobicash",
        "webhooks"
    ],
    "homepage": "https://dpay.ly",
    "support": {
        "docs": "https://dpay.ly/docs/api",
        "issues": "https://github.com/ditsly/dpay-php/issues",
        "source": "https://github.com/ditsly/dpay-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 client (Guzzle 7 or 8); when installed the SDK builds it with TLS verification on, redirects off and the DPay timeouts.",
        "nyholm/psr7": "Lightweight PSR-17 factories when Guzzle is not used."
    },
    "autoload": {
        "psr-4": {
            "DPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DPay\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": [
            "phpstan analyse --memory-limit=1G",
            "phpstan analyse --memory-limit=1G -c phpstan.tests.neon"
        ],
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:contract": "phpunit --testsuite contract",
        "sync-fixtures": "php tests/Contract/bin/sync-fixtures.php",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
